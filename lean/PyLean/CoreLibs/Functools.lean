/-- `.open`: stated, on the mirror, not proven. -/
def recencyOf (ks : List Nat) : List Nat :=
  ks.foldl (fun l k => l.filter (· ≠ k) ++ [k]) []

/-- After any sequence of calls of a function that never raises, the bounded cache holds exactly the
`maxsize` most recently used keys, oldest first. The "least recently used" of the name. -/
def LruRecency : Prop :=
  ∀ (g : Nat → Nat) (m fuel : Nat) (ks : List Nat), 0 < m →
    let cfg : Cfg Nat Nat := ⟨m, fun k _ => .ret (g k), noFaults Nat, 0⟩
    (driveC cfg (fuel + 2) ks emptyC).2.links.map Prod.fst =
      (recencyOf ks).drop ((recencyOf ks).length - m)

/-- The C3 merge as the type machinery runs it. -/
def BuiltinC3 (W : World) : Prop :=
  ∀ (fuel : Nat) (c : Cls), c3Merge fuel ([[c]] ++ (W.bases c).map W.mro ++ [W.bases c]) = .ok (W.mro c)

/-- Without `abcs`, `_c3_mro` is the built-in linearization: "works exactly like the built-in C3 linearization
used for method resolution". The source splits the bases at the last ABC, which C3 does not, so this needs
that the split cannot change a consistent merge. -/
def C3MroMatchesBuiltin : Prop :=
  ∀ (W : World) (fuel : Nat) (cls : Cls), BuiltinC3 W → c3Mro W (fuel + 1) cls [] = .ok (W.mro cls)

