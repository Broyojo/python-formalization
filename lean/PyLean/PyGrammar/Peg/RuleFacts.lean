/-- Rule number `id` is the rule called `name`, and `RuleStarts` holds of it. -/
def NamedRuleStarts (id : Nat) (name : String) (nullable : Bool) (types : List Nat) : Prop :=
  (ruleOf id).name = name ∧ RuleStarts id nullable types

theorem namedRuleStarts {id : Nat} {name : String} {n : Bool} {t : List Nat}
    (h1 : (ruleOf id).name = name) (h2 : firstOf id = (n, t)) : NamedRuleStarts id name n t := by
  refine ⟨h1, ?_⟩
  have := ruleStarts id
  rw [h2] at this
  exact this

