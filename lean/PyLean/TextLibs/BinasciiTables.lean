/-- The static tables are the tables `get_reverse_table` builds from their alphabets, which is why the
model has one `revT`. An entry of `-1` is 255 in an `unsigned char`. The padding character is the one
difference: `table_a2b_base32` has no entry for `=`, where `get_reverse_table` writes 32, and it does not
show, since both are at least 32. -/
def ReverseTables : Prop :=
  ∀ c, c < 256 →
    tableA2bBase64.getD c 0 = revT b64Alpha (some 61) c ∧
    tableA2bBase85.getD c 0 = revT b85Alpha none c ∧
    tableA2bBase85A85.getD c 0 = revT a85Alpha none c ∧
    tableA2bBase32.getD c 0 = revT b32Alpha none c

theorem reverseTables_proven : ReverseTables := by
  unfold ReverseTables
  decide +kernel

