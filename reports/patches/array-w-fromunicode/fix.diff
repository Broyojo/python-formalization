diff --git a/Lib/test/test_array.py b/Lib/test/test_array.py
index 5809665..7d4508a 100755
--- a/Lib/test/test_array.py
+++ b/Lib/test/test_array.py
@@ -1316,6 +1316,23 @@ def test_unicode(self):
 
         self.assertRaises(TypeError, a.fromunicode)
 
+    def test_fromunicode_empty(self):
+        # gh-XXXXXX: an empty string on an array without a buffer
+        a = array.array(self.typecode)
+        a.fromunicode('')
+        self.assertEqual(a, array.array(self.typecode))
+        a.fromunicode('abc')
+        a.fromunicode('')
+        self.assertEqual(a.tounicode(), 'abc')
+
+        # A large deletion frees the buffer.
+        a = array.array(self.typecode, 'x' * 100)
+        del a[:]
+        a.fromunicode('')
+        self.assertEqual(len(a), 0)
+        a.fromunicode('\u1234')
+        self.assertEqual(a.tounicode(), '\u1234')
+
 
 class NumberTest(BaseTest):
 
