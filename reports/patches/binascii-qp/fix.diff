+/* Return 1 if databuf[in] is a space or tab that b2a_qp copies as is
+ * and then, because a line break follows it, rewrites as =20 or =09. */
+static int
+qp_whitespace_before_eol(const unsigned char *databuf, Py_ssize_t in,
+                         Py_ssize_t datalen, int header)
+{
+    if (databuf[in] != '\t' && (databuf[in] != ' ' || header)) {
+        return 0;
+    }
+    if (in + 1 < datalen && databuf[in+1] == '\n') {
+        return 1;
+    }
+    return (in + 2 < datalen && databuf[in+1] == '\r' &&
+            databuf[in+2] == '\n');
+}
