+    def test_b2a_qp_whitespace_before_line_break(self):
+        # Whitespace before a line break is encoded as =20 or =09.
+        # This must not make the line longer than 76 characters.
+        b2a_qp = binascii.b2a_qp
+        def check(data, expected, header=False, istext=True):
+            encoded = b2a_qp(self.type2test(data),
+                             header=header, istext=istext)
+            self.assertEqual(encoded, expected)
+            self.assertLessEqual(max(map(len, encoded.splitlines())), 76)
+            self.assertEqual(binascii.a2b_qp(encoded, header=header), data)
+
+        check(b'a'*73 + b' \n', b'a'*73 + b'=20\n')
+        check(b'a'*74 + b' \n', b'a'*74 + b'=\n=20\n')
+        check(b'a'*75 + b' \n', b'a'*75 + b'=\n=20\n')
+        check(b'a'*75 + b'\t\n', b'a'*75 + b'=\n=09\n')
+        check(b'a'*73 + b'  \n', b'a'*73 + b' =\n=20\n')
+        check(b'a'*74 + b' \nb', b'a'*74 + b'=\n=20\nb')
+        check(b'a'*74 + b' \r\n', b'a'*74 + b'=\r\n=20\r\n')
+        check(b'a'*75 + b'\t\n', b'a'*75 + b'=\n=09\n', header=True)
+        # In header mode a space is written as '_', which fits.
+        check(b'a'*75 + b' \n', b'a'*75 + b'_\n', header=True)
+        # Without istext the line break is encoded, so the space stays.
+        check(b'a'*74 + b' \n', b'a'*74 + b' =\n=0A', istext=False)
+        for n in range(70, 160):
+            for ws in b' ', b'\t':
+                for eol in b'\n', b'\r\n':
+                    with self.subTest(n=n, ws=ws, eol=eol):
+                        data = b'a'*n + ws + eol
+                        encoded = b2a_qp(self.type2test(data))
+                        lengths = list(map(len, encoded.splitlines()))
+                        self.assertLessEqual(max(lengths), 76)
+                        self.assertEqual(binascii.a2b_qp(encoded), data)
