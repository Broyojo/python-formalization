+        b2a_qp = binascii.b2a_qp
+        type2test = self.type2test
+        self.assertEqual(b2a_qp(type2test(b'a'*75 + b'\n'), istext=False),
+                         b'a'*75 + b'=\n=0A')
+        self.assertEqual(b2a_qp(type2test(b'a'*76 + b'\n'), istext=False),
+                         b'a'*75 + b'=\na=0A')
+        self.assertEqual(b2a_qp(type2test(b'a'*76 + b'\nb'), istext=False),
+                         b'a'*75 + b'=\na=0Ab')
+        for n in range(70, 160):
+            for data in b'a'*n + b'\n', b'a'*n + b'\nb', b'a'*n + b'\r\n':
+                with self.subTest(data=data):
+                    encoded = b2a_qp(self.type2test(data), istext=False)
+                    lengths = list(map(len, encoded.splitlines()))
