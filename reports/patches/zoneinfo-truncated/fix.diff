diff --git a/Lib/test/test_zoneinfo/test_zoneinfo.py b/Lib/test/test_zoneinfo/test_zoneinfo.py
index 6656d7c..78bc4d9 100644
--- a/Lib/test/test_zoneinfo/test_zoneinfo.py
+++ b/Lib/test/test_zoneinfo/test_zoneinfo.py
@@ -823,6 +823,36 @@ def test_abbreviation_index_above_127(self):
         self.assertEqual(dt.tzname(), "ABC")
         self.assertEqual(dt.utcoffset(), ONE_H)
 
+    def test_truncated_or_malformed_file(self):
+        def header(version, timecnt=0):
+            # One local time type with a 4-byte abbreviation block
+            return (b"TZif" + version + b"\x00" * 15
+                    + struct.pack(">6l", 0, 0, 0, timecnt, 1, 4))
+
+        utc = struct.pack(">lbB", 0, 0, 0) + b"UTC\x00"
+        v2 = header(b"2") + utc + header(b"2") + utc
+        bad_zones = [
+            # Truncated header
+            b"TZif2" + b"\x00" * 15,
+            b"TZif2" + b"\x00" * 38,
+            # Truncated transition times, transition indices or types
+            header(b"\x00", timecnt=2) + b"\x00" * 7,
+            header(b"\x00", timecnt=2) + b"\x00" * 9,
+            header(b"\x00") + b"\x00" * 5,
+            # Footer does not start with a newline
+            v2 + b"UTC0\n",
+            v2,
+        ]
+
+        for bad_zone in bad_zones:
+            with self.subTest(bad_zone=bad_zone):
+                with self.assertRaises(ValueError):
+                    self.klass.from_file(io.BytesIO(bad_zone))
+
+        # The same data with a valid footer is accepted
+        zi = self.klass.from_file(io.BytesIO(v2 + b"\nUTC0\n"))
+        self.assertEqual(datetime(2026, 1, 1, tzinfo=zi).tzname(), "UTC")
+
     def test_transition_lookahead_out_of_bounds(self):
         STD = ZoneOffset("STD", ZERO)
         DST = ZoneOffset("DST", ONE_H, ONE_H)
